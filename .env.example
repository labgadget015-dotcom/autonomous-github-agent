# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# ===================================
# GitHub Configuration
# ===================================
# GitHub Personal Access Token (PAT) with repo, workflow, and read:org permissions
GITHUB_TOKEN=ghp_your_token_here

# GitHub API Base URL (default: https://api.github.com)
GITHUB_API_URL=https://api.github.com

# Repository configuration
GITHUB_REPOSITORY_OWNER=your-username
GITHUB_REPOSITORY_NAME=your-repo-name

# ===================================
# Code Quality Thresholds
# ===================================
# Minimum acceptable code quality score (0.0-10.0)
QUALITY_THRESHOLD=7.0

# Maximum acceptable cyclomatic complexity
COMPLEXITY_THRESHOLD=10

# Minimum test coverage percentage
MIN_COVERAGE=80

# ===================================
# Security Configuration
# ===================================
# Bandit severity threshold (LOW, MEDIUM, HIGH)
BANDIT_SEVERITY_THRESHOLD=MEDIUM

# Maximum critical vulnerabilities allowed (default: 0)
MAX_CRITICAL_VULNS=0

# ===================================
# CI/CD Configuration
# ===================================
# Python version for CI/CD
PYTHON_VERSION=3.11

# Cache version (increment to invalidate caches)
CACHE_VERSION=v2

# Workflow timeout in minutes
WORKFLOW_TIMEOUT=30

# ===================================
# Monitoring & Observability
# ===================================
# Prometheus metrics endpoint (optional)
PROMETHEUS_ENDPOINT=http://localhost:9090

# Grafana dashboard URL (optional)
GRAFANA_DASHBOARD_URL=http://localhost:3000

# Datadog API key (optional)
DATADOG_API_KEY=your_datadog_api_key_here

# ===================================
# Logging Configuration
# ===================================
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log format (json, text)
LOG_FORMAT=json

# ===================================
# Development Configuration
# ===================================
# Development mode (true, false)
DEV_MODE=false

# Debug mode (true, false)
DEBUG=false

# ===================================
# Agent Configuration
# ===================================
# AI model for agent (e.g., gpt-4, claude-3)
AGENT_MODEL=gpt-4

# Maximum tokens for AI responses
MAX_TOKENS=4000

# Agent temperature (0.0-1.0)
AGENT_TEMPERATURE=0.7

# ===================================
# Notification Configuration
# ===================================
# Slack webhook URL for notifications (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Email notification settings (optional)
NOTIFICATION_EMAIL=your-email@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password

# ===================================
# Database Configuration (if applicable)
# ===================================
# Database URL
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ===================================
# API Rate Limiting
# ===================================
# GitHub API rate limit buffer (requests to keep in reserve)
API_RATE_LIMIT_BUFFER=100

# API request timeout in seconds
API_TIMEOUT=30
