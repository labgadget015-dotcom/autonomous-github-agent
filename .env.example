# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# ===================================
# GitHub Configuration
# ===================================
# GitHub Personal Access Token (PAT) with repo, workflow, and read:org permissions
GITHUB_TOKEN=ghp_your_token_here

# GitHub API Base URL (default: https://api.github.com)
GITHUB_API_URL=https://api.github.com

# Repository configuration
GITHUB_REPOSITORY_OWNER=your-username
GITHUB_REPOSITORY_NAME=your-repo-name

# ===================================
# Code Quality Thresholds
# ===================================
# Minimum acceptable code quality score (0.0-10.0)
QUALITY_THRESHOLD=7.0

# Maximum acceptable cyclomatic complexity
COMPLEXITY_THRESHOLD=10

# Minimum test coverage percentage
MIN_COVERAGE=80

# ===================================
# Security Configuration
# ===================================
# Bandit severity threshold (LOW, MEDIUM, HIGH)
BANDIT_SEVERITY_THRESHOLD=MEDIUM

# Maximum critical vulnerabilities allowed (default: 0)
MAX_CRITICAL_VULNS=0

# ===================================
# CI/CD Configuration
# ===================================
# Python version for CI/CD
PYTHON_VERSION=3.11

# Cache version (increment to invalidate caches)
CACHE_VERSION=v2

# Workflow timeout in minutes
WORKFLOW_TIMEOUT=30

# ===================================
# Monitoring & Observability
# ===================================
# Prometheus metrics endpoint (optional)
PROMETHEUS_ENDPOINT=http://localhost:9090

# Grafana dashboard URL (optional)
GRAFANA_DASHBOARD_URL=http://localhost:3000

# Datadog API key (optional)
DATADOG_API_KEY=your_datadog_api_key_here

# ===================================
# Logging Configuration
# ===================================
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log format (json, text)
LOG_FORMAT=json

# ===================================
# Development Configuration
# ===================================
# Development mode (true, false)
DEV_MODE=false

# Debug mode (true, false)
DEBUG=false

# ===================================
# Agent Configuration
# ===================================
# AI model for agent (e.g., gpt-4, claude-3)
AGENT_MODEL=gpt-4

# Maximum tokens for AI responses
MAX_TOKENS=4000

# Agent temperature (0.0-1.0)
AGENT_TEMPERATURE=0.7

# ===================================
# Notification Configuration
# ===================================
# Slack webhook URL for notifications (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Email notification settings (optional)
NOTIFICATION_EMAIL=your-email@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password

# ===================================
# Database Configuration (if applicable)
# ===================================
# Database URL
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ===================================
# API Rate Limiting
# ===================================
# GitHub API rate limit buffer (requests to keep in reserve)
API_RATE_LIMIT_BUFFER=100

# API request timeout in seconds
API_TIMEOUT=30

# ===================================
# Context Management (Smart Modes)
# ===================================
# Context gathering mode (MINIMAL, STANDARD, COMPREHENSIVE)
CONTEXT_MODE=STANDARD

# Token optimization
MAX_CONTEXT_TOKENS=8000
TOKEN_COST_PER_1K_INPUT=0.03
TOKEN_COST_PER_1K_OUTPUT=0.06

# File size thresholds
MAX_FILE_SIZE_KB=500
SMALL_FILE_THRESHOLD_KB=50

# ===================================
# Chain-of-Thought (CoT) Selection
# ===================================
# CoT reasoning mode (SKIP, SIMPLE, DETAILED, EXHAUSTIVE)
COT_MODE=SIMPLE

# Thresholds for CoT selection
COMPLEXITY_COT_THRESHOLD=15
SECURITY_COT_THRESHOLD=HIGH

# ===================================
# Code Quality Analysis (Objectives 1, 4)
# ===================================
# Parallel analysis tools
ENABLE_PYLINT=true
ENABLE_FLAKE8=true
ENABLE_BANDIT=true
ENABLE_RADON=true

# Radon complexity thresholds
RADON_CC_MIN=C
RADON_CC_MAX=F
RADON_MI_MIN=0
RADON_MI_MAX=100

# Auto-comment on PR for high complexity
AUTO_COMMENT_HIGH_COMPLEXITY=true

# ===================================
# Test Coverage (Objective 2)
# ===================================
# Pytest configuration
PYTEST_WORKERS=auto
PYTEST_DISCOVERY_MODE=minimal

# Coverage targets
COVERAGE_TARGET_PERCENT=80
COVERAGE_FAIL_UNDER=70

# Coverage badge generation
GENERATE_COVERAGE_BADGE=true

# ===================================
# Security Scanning (Objective 3)
# ===================================
# Pre-commit security hooks
PRECOMMIT_BANDIT_ENABLED=true
BLOCK_CRITICAL_VULNS=true

# Security thresholds
MAX_HIGH_SEVERITY_VULNS=0
MAX_MEDIUM_SEVERITY_VULNS=5

# ===================================
# Escalation Workflow (Objective 5)
# ===================================
# Auto-create GitHub issues on threshold violations
AUTO_CREATE_ISSUES=true

# Issue labels and assignees
ISSUE_LABELS=quality,automated
ISSUE_ASSIGNEES=labgadget015-dotcom

# Escalation thresholds
ESCALATE_COMPLEXITY_THRESHOLD=20
ESCALATE_COVERAGE_DROP_PERCENT=10

# ===================================
# Self-Hosted Runners (Objective 6)
# ===================================
# SELF_HOSTED_RUNNER_ENABLED=false
# SELF_HOSTED_RUNNER_LABELS=gpu,high-memory

# ===================================
# Dashboards & Reporting (Objectives 6, 7)
# ===================================
# Dashboard update intervals
DASHBOARD_UPDATE_INTERVAL_MINUTES=15
DASHBOARD_RETENTION_DAYS=90

# Report generation
GENERATE_DAILY_REPORTS=true
GENERATE_WEEKLY_SUMMARIES=true

# Report delivery
REPORT_SLACK_CHANNEL=#ci-reports

# ===================================
# Prometheus Metrics (Objective 9)
# ===================================
# Enable metrics export
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# Metrics to track
TRACK_WORKFLOW_DURATION=true
TRACK_TEST_SUCCESS_RATE=true
TRACK_CODE_QUALITY_TRENDS=true

# ===================================
# Proactive PR Feedback (Objective 10)
# ===================================
# Inline PR comments
ENABLE_INLINE_PR_COMMENTS=true
COMMENT_ON_COMPLEXITY_INCREASE=true
COMMENT_ON_COVERAGE_DECREASE=true
COMMENT_ON_SECURITY_ISSUES=true

# Comment thresholds
COMPLEXITY_INCREASE_THRESHOLD=5
COVERAGE_DECREASE_THRESHOLD=5

# ===================================
# Advanced Features
# ===================================
# A/B Testing
# AB_TESTING_ENABLED=false
# AB_TEST_COHORT=control  # control, variant_a, variant_b

# Notes
# ===================================
# 1. For local development, set DEV_MODE=true
# 2. Install pre-commit hooks: pre-commit install
# 3. Run tests locally: pytest -n auto
# 4. Check configuration: python -c 'from dotenv import load_dotenv; load_dotenv(); import os; print("Configuration loaded successfully")'
# 5. For production, use GitHub Secrets instead of .env file
