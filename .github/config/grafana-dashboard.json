{
  "dashboard": {
    "title": "GitHub Actions CI/CD Dashboard",
    "tags": ["github-actions", "ci-cd", "automation"],
    "timezone": "browser",
    "schemaVersion": 27,
    "version": 1,
    "refresh": "5m",
    
    "panels": [
      {
        "id": 1,
        "title": "Workflow Success Rate",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "github_workflow_success_rate",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "orientation": "auto",
          "textMode": "value_and_name",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 70, "color": "yellow"},
                {"value": 90, "color": "green"}
              ]
            }
          }
        }
      },
      
      {
        "id": 2,
        "title": "Total Workflow Runs",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0},
        "targets": [
          {
            "expr": "github_workflow_runs_total",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "orientation": "auto",
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        }
      },
      
      {
        "id": 3,
        "title": "Average Workflow Duration",
        "type": "gauge",
        "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "github_workflow_duration_seconds{type=\"avg\"}",
            "refId": "A"
          }
        ],
        "options": {
          "orientation": "auto",
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 300, "color": "yellow"},
                {"value": 600, "color": "red"}
              ]
            },
            "max": 1200,
            "min": 0
          }
        }
      },
      
      {
        "id": 4,
        "title": "API Rate Limit Usage",
        "type": "gauge",
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
        "targets": [
          {
            "expr": "github_api_rate_limit_usage",
            "refId": "A"
          }
        ],
        "options": {
          "orientation": "auto",
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 70, "color": "yellow"},
                {"value": 90, "color": "red"}
              ]
            },
            "max": 100,
            "min": 0
          }
        }
      },
      
      {
        "id": 5,
        "title": "Workflow Duration Over Time",
        "type": "graph",
        "gridPos": {"h": 9, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "github_workflow_duration_seconds{type=\"avg\"}",
            "legendFormat": "Average Duration",
            "refId": "A"
          },
          {
            "expr": "github_workflow_duration_seconds{type=\"max\"}",
            "legendFormat": "Max Duration",
            "refId": "B"
          },
          {
            "expr": "github_workflow_duration_seconds{type=\"min\"}",
            "legendFormat": "Min Duration",
            "refId": "C"
          }
        ],
        "yaxes": [
          {
            "format": "s",
            "label": "Duration"
          },
          {
            "format": "short"
          }
        ],
        "xaxis": {
          "mode": "time"
        }
      },
      
      {
        "id": 6,
        "title": "Workflow Success/Failure Breakdown",
        "type": "piechart",
        "gridPos": {"h": 9, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "github_workflow_runs_success",
            "legendFormat": "Success",
            "refId": "A"
          },
          {
            "expr": "github_workflow_runs_failure",
            "legendFormat": "Failure",
            "refId": "B"
          },
          {
            "expr": "github_workflow_runs_cancelled",
            "legendFormat": "Cancelled",
            "refId": "C"
          }
        ],
        "options": {
          "pieType": "pie",
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          }
        }
      },
      
      {
        "id": 7,
        "title": "Code Quality Score Trend",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 17},
        "targets": [
          {
            "expr": "code_quality_score",
            "legendFormat": "Quality Score",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "short",
            "label": "Score",
            "max": 10,
            "min": 0
          },
          {
            "format": "short"
          }
        ],
        "xaxis": {
          "mode": "time"
        },
        "alert": {
          "conditions": [
            {
              "evaluator": {
                "params": [7.0],
                "type": "lt"
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": ["A", "5m", "now"]
              },
              "reducer": {
                "params": [],
                "type": "avg"
              },
              "type": "query"
            }
          ],
          "name": "Code Quality Alert"
        }
      },
      
      {
        "id": 8,
        "title": "Test Coverage Percentage",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 17},
        "targets": [
          {
            "expr": "test_coverage_percentage",
            "legendFormat": "Coverage %",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "percent",
            "label": "Coverage",
            "max": 100,
            "min": 0
          },
          {
            "format": "short"
          }
        ],
        "xaxis": {
          "mode": "time"
        },
        "alert": {
          "conditions": [
            {
              "evaluator": {
                "params": [80],
                "type": "lt"
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": ["A", "5m", "now"]
              },
              "reducer": {
                "params": [],
                "type": "avg"
              },
              "type": "query"
            }
          ],
          "name": "Coverage Alert"
        }
      },
      
      {
        "id": 9,
        "title": "Security Vulnerabilities",
        "type": "stat",
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 25},
        "targets": [
          {
            "expr": "security_vulnerabilities_high",
            "legendFormat": "High Severity",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "orientation": "auto",
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 1, "color": "red"}
              ]
            }
          }
        }
      },
      
      {
        "id": 10,
        "title": "Code Complexity (Avg)",
        "type": "gauge",
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 25},
        "targets": [
          {
            "expr": "code_complexity_average",
            "refId": "A"
          }
        ],
        "options": {
          "orientation": "auto",
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 10, "color": "yellow"},
                {"value": 15, "color": "red"}
              ]
            },
            "max": 20,
            "min": 0
          }
        }
      },
      
      {
        "id": 11,
        "title": "Build Time Percentiles",
        "type": "graph",
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 25},
        "targets": [
          {
            "expr": "histogram_quantile(0.5, github_workflow_duration_seconds_bucket)",
            "legendFormat": "p50",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, github_workflow_duration_seconds_bucket)",
            "legendFormat": "p95",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, github_workflow_duration_seconds_bucket)",
            "legendFormat": "p99",
            "refId": "C"
          }
        ],
        "yaxes": [
          {
            "format": "s",
            "label": "Duration"
          },
          {
            "format": "short"
          }
        ],
        "xaxis": {
          "mode": "time"
        }
      }
    ],
    
    "time": {
      "from": "now-7d",
      "to": "now"
    },
    
    "timepicker": {
      "refresh_intervals": ["5m", "15m", "30m", "1h", "2h", "1d"]
    },
    
    "annotations": {
      "list": [
        {
          "datasource": "-- Grafana --",
          "enable": true,
          "hide": false,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Deployments",
          "type": "dashboard"
        }
      ]
    }
  }
}
