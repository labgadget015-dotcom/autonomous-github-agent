{
  "title": "Repository Health Dashboard",
  "uid": "gadgetlab-repo-health",
  "tags": ["github", "ci-cd", "code-quality", "llm-cost"],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Health Score",
      "type": "gauge",
      "targets": [
        {
          "expr": "repo_health_score",
          "legendFormat": "Health Score"
        }
      ],
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 8},
      "options": {
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "red"},
              {"value": 60, "color": "orange"},
              {"value": 75, "color": "yellow"},
              {"value": 90, "color": "green"}
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Test Coverage",
      "type": "gauge",
      "targets": [
        {
          "expr": "test_coverage_percentage",
          "legendFormat": "Coverage %"
        }
      ],
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 8},
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "red"},
              {"value": 55, "color": "orange"},
              {"value": 70, "color": "green"}
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Code Complexity",
      "type": "gauge",
      "targets": [
        {
          "expr": "code_complexity_average",
          "legendFormat": "Avg Complexity"
        }
      ],
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 8},
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 20,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 10, "color": "yellow"},
              {"value": 15, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Maintainability Index",
      "type": "gauge",
      "targets": [
        {
          "expr": "code_maintainability_average",
          "legendFormat": "Maintainability"
        }
      ],
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 8},
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "red"},
              {"value": 50, "color": "orange"},
              {"value": 65, "color": "yellow"},
              {"value": 85, "color": "green"}
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Workflow Success Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(workflow_runs_total{status=\"success\"}[1h]) / rate(workflow_runs_total[1h]) * 100",
          "legendFormat": "Success Rate"
        }
      ],
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}
    },
    {
      "id": 6,
      "title": "Workflow Duration",
      "type": "timeseries",
      "targets": [
        {
          "expr": "workflow_duration_seconds",
          "legendFormat": "{{workflow}}"
        }
      ],
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "fieldConfig": {
        "defaults": {"unit": "s"}
      }
    },
    {
      "id": 7,
      "title": "Security Issues by Severity",
      "type": "bargauge",
      "targets": [
        {
          "expr": "security_issues_total",
          "legendFormat": "{{severity}}"
        }
      ],
      "gridPos": {"x": 0, "y": 16, "w": 8, "h": 8}
    },
    {
      "id": 8,
      "title": "Quality Violations",
      "type": "piechart",
      "targets": [
        {
          "expr": "quality_violations_total",
          "legendFormat": "{{type}}"
        }
      ],
      "gridPos": {"x": 8, "y": 16, "w": 8, "h": 8}
    },
    {
      "id": 9,
      "title": "Code Quality Scores by Tool",
      "type": "bargauge",
      "targets": [
        {
          "expr": "code_quality_score",
          "legendFormat": "{{tool}}"
        }
      ],
      "gridPos": {"x": 16, "y": 16, "w": 8, "h": 8}
    },
    {
      "id": 10,
      "title": "LLM Session Cost (USD)",
      "type": "timeseries",
      "description": "Per-call LLM spend from .llm_costs.jsonl — appended by LLMClient._record_cost()",
      "targets": [
        {
          "expr": "llm_session_cost_usd",
          "legendFormat": "{{model}}"
        }
      ],
      "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8},
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 0.5, "color": "orange"},
              {"value": 1.0, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 11,
      "title": "LLM Tokens Used",
      "type": "timeseries",
      "targets": [
        {
          "expr": "llm_tokens_total",
          "legendFormat": "{{type}}"
        }
      ],
      "gridPos": {"x": 12, "y": 24, "w": 12, "h": 8},
      "fieldConfig": {
        "defaults": {"unit": "short"}
      }
    },
    {
      "id": 12,
      "title": "LLM Routing Split (Local vs Cloud)",
      "type": "piechart",
      "description": "Fraction of calls served by local vs cloud LLM — from llm_router stats",
      "targets": [
        {
          "expr": "llm_router_requests_total",
          "legendFormat": "{{destination}}"
        }
      ],
      "gridPos": {"x": 0, "y": 32, "w": 12, "h": 8}
    },
    {
      "id": 13,
      "title": "n8n DRC Health",
      "type": "stat",
      "description": "Latest HTTP status from the n8n health check workflow",
      "targets": [
        {
          "expr": "n8n_drc_health_status",
          "legendFormat": "DRC Webhook"
        }
      ],
      "gridPos": {"x": 12, "y": 32, "w": 12, "h": 8},
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "red"},
              {"value": 200, "color": "green"},
              {"value": 500, "color": "red"}
            ]
          }
        }
      }
    }
  ]
}
