# Development Environment Configuration
# This file contains development-specific settings
# Copy from .env.example and customize for local development

# ===================================
# Development Mode Settings
# ===================================
DEV_MODE=true
DEBUG=true
LOG_LEVEL=DEBUG
LOG_FORMAT=text

# ===================================
# GitHub Configuration (Development)
# ===================================
# Use a development/testing repository to avoid affecting production
GITHUB_TOKEN=ghp_your_development_token_here
GITHUB_API_URL=https://api.github.com
GITHUB_REPOSITORY_OWNER=your-username
GITHUB_REPOSITORY_NAME=test-repo

# ===================================
# Relaxed Quality Thresholds for Development
# ===================================
# Lower thresholds for development to speed up iteration
QUALITY_THRESHOLD=6.0
COMPLEXITY_THRESHOLD=15
MIN_COVERAGE=70

# ===================================
# Security Configuration (Development)
# ===================================
BANDIT_SEVERITY_THRESHOLD=HIGH
MAX_CRITICAL_VULNS=0
MAX_HIGH_SEVERITY_VULNS=2
MAX_MEDIUM_SEVERITY_VULNS=10

# ===================================
# CI/CD Configuration (Development)
# ===================================
PYTHON_VERSION=3.11
CACHE_VERSION=v1-dev
WORKFLOW_TIMEOUT=60

# ===================================
# Fast Test Execution
# ===================================
PYTEST_WORKERS=auto
PYTEST_DISCOVERY_MODE=minimal
COVERAGE_TARGET_PERCENT=70
COVERAGE_FAIL_UNDER=60

# ===================================
# Development Tools
# ===================================
# Enable all analysis tools for comprehensive feedback
ENABLE_PYLINT=true
ENABLE_FLAKE8=true
ENABLE_BANDIT=true
ENABLE_RADON=true

# Auto-fix and auto-format
AUTO_FIX_ISSUES=true
AUTO_FORMAT_CODE=true

# ===================================
# Monitoring & Observability (Development)
# ===================================
# Local monitoring endpoints
PROMETHEUS_ENABLED=false
PROMETHEUS_ENDPOINT=http://localhost:9090
GRAFANA_DASHBOARD_URL=http://localhost:3000

# ===================================
# Notifications (Development)
# ===================================
# Disable notifications in development
SLACK_WEBHOOK_URL=
NOTIFICATION_EMAIL=

# ===================================
# Context Management (Development)
# ===================================
# Use minimal context to speed up development
CONTEXT_MODE=MINIMAL
MAX_CONTEXT_TOKENS=4000
COT_MODE=SKIP

# ===================================
# API Settings (Development)
# ===================================
API_RATE_LIMIT_BUFFER=50
API_TIMEOUT=30

# ===================================
# Hot Reload & Watch Mode
# ===================================
# Enable file watching for rapid development
ENABLE_HOT_RELOAD=true
WATCH_MODE=true

# ===================================
# Database (Development)
# ===================================
# Use local SQLite for development
# DATABASE_URL=sqlite:///./dev.db

# ===================================
# Agent Configuration (Development)
# ===================================
# Use faster/cheaper models for development
AGENT_MODEL=gpt-3.5-turbo
MAX_TOKENS=2000
AGENT_TEMPERATURE=0.7

# ===================================
# Feature Flags (Development)
# ===================================
# Enable experimental features
ENABLE_EXPERIMENTAL_FEATURES=true
ENABLE_INLINE_PR_COMMENTS=true
AUTO_CREATE_ISSUES=false

# ===================================
# Performance Optimization
# ===================================
# Skip slow operations in development
SKIP_SLOW_TESTS=true
SKIP_INTEGRATION_TESTS=false

# ===================================
# Local Development Notes
# ===================================
# 1. Install pre-commit hooks: pre-commit install
# 2. Run tests: pytest -n auto
# 3. Run with hot reload: python -m scripts.setup-dev --watch
# 4. Format code: black . && isort .
# 5. Check quality: make lint
